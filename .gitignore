# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
virt/
venv/
.venv/

# Flask instance folder (local SQLite DB, instance-specific config)
instance/

# Database files
*.db
*.sqlite
*.sqlite3

# Database backups (contain real user/task data)
db_backups/

# Alembic / migrations (regenerate per environment; not currently tracked)
migrations/versions/__pycache__/

# Generated report output
app/downloads/*
!app/downloads/.gitkeep

# User uploads
app/static/uploads/*
!app/static/uploads/.gitkeep

# Backup / scratch copies
app/backup/
*_backup.py

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

